@inherits LayoutComponentBase

<nav class="flex items-center gap-4 border-b border-line px-[5vw] py-[18px] sm:gap-7">
    <a href="/" class="mr-auto font-display text-[1.4rem] font-bold text-gold">CineMatch</a>
    <NavLink href="" Match="NavLinkMatch.All" class="@LinkClass">Discover</NavLink>
    <NavLink href="puzzle" class="@LinkClass">Puzzle</NavLink>
    <NavLink href="profile" class="@LinkClass">Profile</NavLink>
</nav>

<main>
    @Body
</main>

<div id="blazor-error-ui" data-nosnippet class="fixed bottom-0 left-0 z-[1000] hidden w-full bg-yellow-100 px-5 py-3 text-ink shadow-md">
    An unhandled error has occurred.
    <a href="" class="text-blue-600 hover:underline">Reload</a>
    <a class="absolute right-3 top-2 cursor-pointer">🗙</a>
</div>

@code {
    private const string LinkClass =
        "border-b-2 border-transparent py-1 text-muted hover:text-snow [&.active]:border-gold [&.active]:text-snow";
}