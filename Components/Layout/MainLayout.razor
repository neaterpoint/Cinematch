@inherits LayoutComponentBase

<div class="relative flex flex-col sm:flex-row">
    <div class="bg-slate-900 sm:sticky sm:top-0 sm:h-screen sm:w-[250px]">
        <NavMenu />
    </div>

    <main class="flex-1">
        <div class="flex h-14 items-center justify-end border-b border-gray-300 bg-gray-50 px-4 sm:pr-6 sm:pl-8">
            <a href="https://learn.microsoft.com/aspnet/core/" target="_blank" class="text-blue-600 hover:underline">About</a>
        </div>

        <article class="px-4 py-4 sm:pr-6 sm:pl-8">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet class="fixed bottom-0 left-0 z-[1000] hidden w-full bg-yellow-100 px-5 py-3 shadow-md">
    An unhandled error has occurred.
    <a href="" class="text-blue-600 hover:underline">Reload</a>
    <a class="absolute right-3 top-2 cursor-pointer">🗙</a>
</div>